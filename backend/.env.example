# ============================================================
# PAE API - Variables de entorno
# Copia este archivo a ".env" y completa los valores.
# ============================================================

# Puerta en la que corre el backend (4000 por defecto)
PORT=4000

# Datos de Supabase (los encuentras en supabase.com -> Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Clave de la API de Gemini para el chatbot PAE
# (gratis en https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# ============================================================
# Panel de administracion
# ============================================================

# Clave del panel de admin (la que escribe el director en /admin)
# Si no se define, la clave por defecto es "pae2026"
ADMIN_CLAVE=

# Secreto con el que se firman los tokens del panel (debe ser largo)
# Si no se define, usa ADMIN_CLAVE
ADMIN_SECRET=

# ============================================================
# Notificaciones por email (OPCIONAL)
# Si completas estos datos, cada reserva envia un correo de
# confirmacion. Si los dejas vacios, la notificacion solo se
# guarda en la base para verla desde el panel.
#
# Se usa Resend (resend.com), que envia por HTTP (puerto 443),
# porque Render (plan gratis) bloquea los puertos SMTP (25/465/587).
# ============================================================

# API key de Resend (Dashboard -> API Keys)
RESEND_API_KEY=

# Remitente. Debe ser un dominio verificado en Resend, o bien
# "onboarding@resend.dev" si solo quieres probar enviandote a tu
# propia cuenta de Resend.
RESEND_FROM=
